# Banco de clima local (PostgreSQL). Para migrar para a nuvem, troque só esta URL.
CLIMA_DB_URL=postgresql://clima:clima@localhost:5432/clima_varejo

# Base da Rock (lakehouse), somente leitura. Pendente: política interna e credencial.
ROCK_LAKEHOUSE_URL=

# Copernicus CDS (ERA5-Land). Pendente: criar conta e aceitar a licença.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Diretório de dados brutos baixados (pacotes do INMET, CSVs da Epagri etc.)
CLIMA_DATA_DIR=./data
